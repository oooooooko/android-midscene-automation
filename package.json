    "@vue-flow/core": "1.48.2",
    "element-plus": "2.11.1",
    "openai": "5.23.2",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vue": "3.5.39",
    "word-extractor": "1.0.4",
    "xlsx": "0.18.5",
