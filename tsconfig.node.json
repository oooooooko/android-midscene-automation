{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "noEmit": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "scripts/**/*.ts", "server/**/*.ts", "remote-agent/**/*.ts", "e2e/**/*.ts"]
}
